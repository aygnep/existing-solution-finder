{
  "name": "fixseek",
  "version": "0.1.0",
  "description": "Find existing fixes, tools, GitHub issues, packages, and workarounds before you build from scratch.",
  "main": "dist/cli/index.js",
  "bin": {
    "fixseek": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc",
    "build:web": "vite build --config web/vite.config.mts",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "web:gateway": "node dist/web/gateway.js",
    "web:client": "vite --config web/vite.config.mts",
    "web:dev": "concurrently \"npm run web:gateway\" \"npm run web:client\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark:real": "npm run build:core && node dist/benchmark/index.js",
    "benchmark:update": "npm run build:core && node dist/benchmark/index.js --update-baseline",
    "lint": "eslint src tests web/src e2e --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "github-search",
    "npm-search",
    "troubleshooting",
    "debugging",
    "bugfix",
    "workaround",
    "solution-finder"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aygnep/existing-solution-finder.git"
  },
  "bugs": {
    "url": "https://github.com/aygnep/existing-solution-finder/issues"
  },
  "homepage": "https://github.com/aygnep/existing-solution-finder#readme",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5",
    "vite": "^5.4.10"
  }
}
