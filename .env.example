# Fixseek environment variables
#
# Real providers are the CLI default. Mock mode is explicit and needs no token:
#   npm start -- solve --mock "your problem"
#
# GitHub requires GITHUB_TOKEN; npm needs no token:
#   npm start -- solve --provider github "your problem"
#
# Never commit .env or real API tokens.

# GitHub Personal Access Token for real GitHub mode.
# Create at: https://github.com/settings/tokens
# Scopes needed: public_repo or read-only public repository access.
GITHUB_TOKEN=

# Optional: web search provider configuration.
# Supported providers: brave, serpapi
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# Optional Jev reranking. Runs only with --reranker jev or the Web opt-in.
# The problem and bounded candidate excerpts are sent to TypeSafe AI.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Optional local Laya reranker. Fixseek only connects to 127.0.0.1.
LAYA_PORT=8766

# Optional: use one explicit env file instead of cwd/.env and
# ~/.config/fixseek/.env.
# FIXSEEK_ENV_FILE=

# Optional: outcome feedback JSONL path.
# Default: ~/.config/fixseek/outcomes.jsonl
# FIXSEEK_OUTCOME_FILE=

# Optional: log level (debug | info | warn | error)
LOG_LEVEL=warn

# Optional: max results requested per search provider
MAX_RESULTS_PER_PROVIDER=10

# Optional: request timeout in milliseconds
REQUEST_TIMEOUT_MS=10000
